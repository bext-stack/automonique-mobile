{
  "expo": {
    "name": "Automonique",
    "slug": "automonique-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/automonique-icon-opaque.png",
    "scheme": "automonique",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/automonique-icon-opaque.png",
      "bundleIdentifier": "dev.bext.automonique",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false
        },
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "dev.bext.automonique",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#0B3529",
        "foregroundImage": "./assets/images/automonique-mark.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/automonique-icon-opaque.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5F0",
          "dark": {
            "backgroundColor": "#111310",
            "image": "./assets/images/automonique-mark.png"
          },
          "image": "./assets/images/automonique-mark.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Automonique to scan a one-time server pairing QR code on this device.",
          "microphonePermission": "Allow Automonique to use your voice: as a text follow-up you review, or streamed to your paired server during a live call with an agent.",
          "photosPermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Automonique to use your voice: as a text follow-up you review, or streamed to your paired server during a live call with an agent.",
          "speechRecognitionPermission": "Allow Automonique to transcribe speech into a reviewable text follow-up."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
