{
  "name": "automonique-mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "license": "Elastic-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.10.1",
  "dependencies": {
    "@automonique/sdk": "file:vendor/automonique-sdk-0.1.0.tgz",
    "@react-native-async-storage/async-storage": "2.2.0",
    "base64-js": "1.5.1",
    "expo": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "jpeg-js": "0.4.4",
    "jsqr": "1.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/qrcode": "1.5.6",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "expo-build-properties": "~57.0.14",
    "expo-doctor": "^1.20.3",
    "jest": "29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.9.6",
    "qrcode": "1.5.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node scripts/harden-xcode-uuid.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sdk:verify": "node scripts/verify-vendored-sdk.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "native:verify": "node scripts/verify-native-policy.mjs",
    "security:verify": "node scripts/harden-xcode-uuid.mjs --check",
    "production:verify": "node scripts/verify-production-boundary.mjs",
    "production:verify:bundle": "node scripts/verify-production-boundary.mjs --require-bundle",
    "audit:high": "npm audit --audit-level=high",
    "doctor": "expo-doctor",
    "bundle:platforms": "expo export --platform all --output-dir dist",
    "validate": "npm run sdk:verify && npm run notices:check && npm run security:verify && npm run native:verify && npm run production:verify && npm run audit:high && npm run typecheck && npm run lint && npm run test:ci && npm run format:check && npm run doctor && npm run bundle:platforms && npm run production:verify:bundle"
  },
  "overrides": {
    "xcode": {
      "uuid": "14.0.2"
    }
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@automonique/sdk))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
